{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "turntail",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // ONE store web build host (Cloudflare Pages). Exact origins only, comma separated. See lib/store-cors.ts.
  "vars": {
    // https://localhost: the Google Play app (Capacitor serves the game from inside the APK at this origin).
    "TURNTALE_ALLOWED_ORIGINS": "https://turntale-onestore.pages.dev,https://localhost"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "turntail-production",
      "database_id": "9a24b49d-ab34-4cbb-801e-17f9d8dc92f3"
    }
  ]
}
